{
  "name": "dad-vscode-extension",
  "displayName": "DAD - Diagram as a Delivery",
  "description": "Visualize .dad.json architecture diagrams",
  "version": "0.0.1",
  "publisher": "dad",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/velvee-ai/dad.git"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:dad.visualizeDadFile",
    "onCommand:dad.analyzeProject",
    "onCommand:dad.enableAuthorMode",
    "onCommand:dad.generateLandscape"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dad.visualizeDadFile",
        "title": "DAD: Visualize"
      },
      {
        "command": "dad.analyzeProject",
        "title": "DAD: Analyze Project"
      },
      {
        "command": "dad.enableAuthorMode",
        "title": "DAD: Enable Author Mode"
      },
      {
        "command": "dad.generateLandscape",
        "title": "DAD: Generate Landscape"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dad.visualizeDadFile",
          "when": "resourceFilename =~ /\\.dad\\.json$/",
          "group": "navigation"
        },
        {
          "command": "dad.analyzeProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "dad.generateLandscape",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "NODE_ENV=production webpack --mode production",
    "dev": "webpack --mode development --watch",
    "compile": "NODE_ENV=production webpack --mode production",
    "watch": "webpack --mode development --watch",
    "package": "vsce package --no-dependencies",
    "install-extension": "agy --install-extension dad-vscode-extension-0.0.1.vsix",
    "pretest": "pnpm run compile",
    "test": "node ./out/test/runTest.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@dad/generation": "workspace:*",
    "@dad/pipeline": "workspace:*",
    "@dad/shared-types": "workspace:*",
    "@dad/visualizer": "workspace:*",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  }
}