{
  "name": "dad-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "DAD - Diagram as a Delivery Monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/velvee-ai/dad.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "package:extension": "turbo run build --filter=dad-vscode-extension && pnpm --filter dad-vscode-extension run package"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.2.5",
    "turbo": "^1.12.5",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.24.0"
  }
}
